# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string. Signs sessions AND peppers PIN hashes: changing it invalidates every PIN.
SESSION_SECRET=
# Web Push keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: sent to push services
VAPID_SUBJECT=https://your-app.vercel.app
# Daily dashboard digest on Telegram (Vercel Cron, 9 PM Bangladesh time)
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat id(s) to send to, comma-separated (yours, or the flat's group with the bot added)
TELEGRAM_CHAT_ID=
# Long random string; Vercel Cron sends it so nobody else can trigger the digest
CRON_SECRET=
