# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string. Signs sessions AND peppers PIN hashes: changing it invalidates every PIN.
SESSION_SECRET=
# Secret code flatmates enter to join (or to set a new PIN after a backup restore)
HOUSE_CODE=
# Web Push keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: sent to push services
VAPID_SUBJECT=https://your-app.vercel.app
